<!-- Mascote Animations Stylesheet -->
<style data-purpose="mascot-animations">
    @keyframes mascotBobbing {
      0%, 100% {
        transform: translateY(0px) rotate(0deg);
      }
      25% {
        transform: translateY(-8px) rotate(-1.5deg);
      }
      50% {
        transform: translateY(-12px) rotate(0deg);
      }
      75% {
        transform: translateY(-6px) rotate(1.5deg);
      }
    }

    @keyframes chefHatSquash {
      0%, 100% {
        transform: translateY(0) scale(1, 1) rotate(0deg);
      }
      30% {
        transform: translateY(-3px) scale(0.98, 1.04) rotate(1deg);
      }
      60% {
        transform: translateY(1px) scale(1.03, 0.97) rotate(-1deg);
      }
    }

    @keyframes eyeBlink {
      0%, 94%, 98%, 100% {
        transform: scaleY(1);
      }
      96% {
        transform: scaleY(0.1);
      }
    }

    @keyframes cheekGlow {
      0%, 100% {
        opacity: 0.65;
        transform: scale(1);
      }
      50% {
        opacity: 0.95;
        transform: scale(1.15);
      }
    }

    @keyframes shadowPulse {
      0%, 100% {
        transform: scaleX(1) scaleY(1);
        opacity: 0.35;
      }
      50% {
        transform: scaleX(0.78) scaleY(0.7);
        opacity: 0.16;
      }
    }

    @keyframes sparkleFloat1 {
      0%, 100% {
        transform: translate(0, 0) scale(0.8) rotate(0deg);
        opacity: 0.3;
      }
      50% {
        transform: translate(-4px, -8px) scale(1.15) rotate(45deg);
        opacity: 1;
      }
    }

    @keyframes sparkleFloat2 {
      0%, 100% {
        transform: translate(0, 0) scale(0.7) rotate(0deg);
        opacity: 0.25;
      }
      50% {
        transform: translate(5px, -10px) scale(1.1) rotate(-35deg);
        opacity: 0.95;
      }
    }

    .animate-mascot {
      animation: mascotBobbing 3.8s ease-in-out infinite;
      transform-origin: center bottom;
    }

    .animate-chef-hat {
      animation: chefHatSquash 3.8s ease-in-out infinite;
      transform-origin: center bottom;
    }

    .animate-blink {
      animation: eyeBlink 3.8s infinite;
      transform-origin: center;
    }

    .animate-cheek {
      animation: cheekGlow 2.5s ease-in-out infinite;
      transform-origin: center;
    }

    .animate-shadow {
      animation: shadowPulse 3.8s ease-in-out infinite;
      transform-origin: center;
    }

    .animate-sparkle-1 {
      animation: sparkleFloat1 2.8s ease-in-out infinite;
    }

    .animate-sparkle-2 {
      animation: sparkleFloat2 3.3s ease-in-out 0.8s infinite;
    }

    /* Hide scrollbars for clean filter pills scroll */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
